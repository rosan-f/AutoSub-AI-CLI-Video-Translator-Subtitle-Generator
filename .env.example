# ================================================================
# AutoSub-AI — Environment Configuration
# ================================================================
# Copy this file to .env and fill in your values.
# The .env file must NOT be committed to version control.
# ================================================================

# Whisper model size: tiny, base, small, medium, large
AUTOSUB_MODEL_SIZE=base

# Target translation language (ISO 639-1 code)
AUTOSUB_TARGET_LANGUAGE=id

# Output directory for generated .srt files
AUTOSUB_OUTPUT_DIR=./output

# Download directory for temporary audio files
AUTOSUB_DOWNLOAD_DIR=./downloads

# Log level: DEBUG, INFO, WARNING, ERROR
AUTOSUB_LOG_LEVEL=INFO

# Enable GPU acceleration (requires CUDA-compatible GPU)
AUTOSUB_USE_GPU=true
